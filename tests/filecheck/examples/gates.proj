// RUN: xdsl-opt %s | filecheck %s

// CHECK-LABEL: proj.unitary @X
// CHECK:        proj.eq %q : !proj.qubit<x>, #proj.state<minus>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn X(q: qubit<X>) {
  if q == |-> {
    ph(pi)
  }
}

// CHECK-LABEL: proj.unitary @Y
// CHECK:        proj.eq %q : !proj.qubit<y>, #proj.state<right>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn Y(q: qubit<Y>) {
  if q == |R> {
    ph(pi)
  }
}

// CHECK-LABEL: proj.unitary @Z
// CHECK:        proj.eq %q : !proj.qubit<z>, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn Z(q: qubit<Z>) {
  if q == |1> {
    ph(pi)
  }
}

// CHECK-LABEL: proj.unitary @S
// CHECK:        proj.eq %q : !proj.qubit<z>, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     %[[ANGLE:.*]] = angle.scalar_mult 5.000000e-01, %[[PI]]
// CHECK-NEXT:     proj.phase %[[ANGLE]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn S(q: qubit<Z>) {
  if q == |1> {
    ph(0.5*pi)
  }
}

// CHECK-LABEL: proj.unitary @T
// CHECK:        proj.eq %q : !proj.qubit<z>, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     %[[ANGLE:.*]] = angle.scalar_mult 2.500000e-01, %[[PI]]
// CHECK-NEXT:     proj.phase %[[ANGLE]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn T(q: qubit<Z>) {
  if q == |1> {
    ph(0.25*pi)
  }
}

// CHECK-LABEL: proj.unitary @CZ
// CHECK:        proj.eq %c : !proj.qubit<z>, #proj.state<one>
// CHECK-NEXT:   proj.eq %q : !proj.qubit<z>, #proj.state<one>
// CHECK-NEXT:   proj.and %[[EQC:.*]], %[[EQQ:.*]]
// CHECK-NEXT:   proj.if %[[AND:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CZ(c: qubit<Z>, q: qubit<Z>) {
  if c == |1> && q == |1> {
    ph(pi)
  }
}

// CHECK-LABEL: proj.unitary @CX
// CHECK:        proj.eq %c : !proj.qubit<z>, #proj.state<one>
// CHECK-NEXT:   proj.eq %q : !proj.qubit<x>, #proj.state<minus>
// CHECK-NEXT:   proj.and %[[EQC:.*]], %[[EQQ:.*]]
// CHECK-NEXT:   proj.if %[[AND:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CX(c: qubit<Z>, q: qubit<X>) {
  if c == |1> && q == |-> {
    ph(pi)
  }
}

// CHECK-LABEL: proj.unitary @CondX
// CHECK:        %p = proj.eq %q : !proj.qubit<x>, #proj.state<minus>
// CHECK-NEXT:   proj.if %p {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:     proj.yield
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CondX(b: bool, q: qubit<X>) {
  let p = q == |->;
  if p {
    ph(pi)
  }
}
