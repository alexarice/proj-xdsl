// RUN: xdsl-opt %s | filecheck %s

// CHECK-LABEL: proj.unitary @X
// CHECK:        proj.eq %q : !proj.qubit, #proj.state<minus>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return	
unitary fn X(q: qubit) {
  qif q == |-> {
    ph(pi);
  };
}

// CHECK-LABEL: proj.unitary @Y
// CHECK:        proj.eq %q : !proj.qubit, #proj.state<right>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn Y(q: qubit) {
  qif q == |R> {
    ph(pi);
  };
}

// CHECK-LABEL: proj.unitary @Z
// CHECK:        proj.eq %q : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn Z(q: qubit) {
  qif q == |1> {
    ph(pi);
  };
}

// CHECK-LABEL: proj.unitary @S
// CHECK:        proj.eq %q : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     %[[ANGLE:.*]] = angle.scalar_mult 5.000000e-01, %[[PI]]
// CHECK-NEXT:     proj.phase %[[ANGLE]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn S(q: qubit) {
  qif q == |1> {
    ph(0.5*pi);
  };
}

// CHECK-LABEL: proj.unitary @T
// CHECK:        proj.eq %q : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     %[[ANGLE:.*]] = angle.scalar_mult 2.500000e-01, %[[PI]]
// CHECK-NEXT:     proj.phase %[[ANGLE]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn T(q: qubit) {
  qif q == |1> {
    ph(0.25*pi);
  };
}

// CHECK-LABEL: proj.unitary @CZ
// CHECK:        proj.eq %c : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.eq %q : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.and %[[EQC:.*]], %[[EQQ:.*]]
// CHECK-NEXT:   proj.if %[[AND:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CZ(c: qubit, q: qubit) {
  qif c == |1> && q == |1> {
    ph(pi);
  };
}

// CHECK-LABEL: proj.unitary @CX
// CHECK:        proj.eq %c : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.eq %q : !proj.qubit, #proj.state<minus>
// CHECK-NEXT:   proj.and %[[EQC:.*]], %[[EQQ:.*]]
// CHECK-NEXT:   proj.if %[[AND:.*]] {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CX(c: qubit, q: qubit) {
  qif c == |1> && q == |-> {
    ph(pi);
  };
}

// CHECK-LABEL: proj.unitary @CondX
// CHECK:        %p = proj.eq %q : !proj.qubit, #proj.state<minus>
// CHECK-NEXT:   proj.if %p {
// CHECK-NEXT:     %[[PI:.*]] = angle.pi
// CHECK-NEXT:     proj.phase %[[PI]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CondX(b: bool, q: qubit) {
  let p = q == |->;
  qif p {
    ph(pi);
  };
}

// CHECK-LABEL: proj.unitary @CX_call
// CHECK:        proj.eq %c : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     proj.call @X(%q) : (!proj.qubit) -> ()
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CX_call(c: qubit, q: qubit) {
  qif c == |1> {
    X(q);
  };
}

// CHECK-LABEL: proj.unitary @CZ_call
// CHECK:        proj.eq %c : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     proj.call @Z(%q) : (!proj.qubit) -> ()
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn CZ_call(c: qubit, q: qubit) {
  qif c == |1> {
    Z(q);
  };
}

// CHECK-LABEL: proj.unitary @RZ
// CHECK:        %[[HALF:.*]] = angle.scalar_mult 5.000000e-01, %[[THETA:.*]]
// CHECK:        proj.eq %q : !proj.qubit, #proj.state<one>
// CHECK-NEXT:   proj.if %[[EQ:.*]] {
// CHECK-NEXT:     proj.phase %[[HALF]]
// CHECK-NEXT:   } else {
// CHECK-NEXT:     %[[NEG_HALF:.*]] = angle.scalar_mult -1.000000e+00, %[[HALF]]
// CHECK-NEXT:     proj.phase %[[NEG_HALF]]
// CHECK-NEXT:   }
// CHECK-NEXT:   proj.return
unitary fn RZ(theta: angle, q: qubit) {
  let half = 0.5 * theta;
  qif q == |1> {
    ph(half);
  } else {
    ph(-half);
  };
}
