// RUN: xdsl-opt %s --parsing-diagnostics --split-input-file 2>&1 | filecheck %s

// -----
// Test: locally allocated qubit borrowed at return
// CHECK: Locally allocated qubit is still borrowed at return
mixed fn test() -> proj {
    let q = alloc |0>;
    let p = q == |0>;
    p
}

// -----
// Test: conflicting borrows in same block (Z and X basis)
// CHECK: Cannot combine projections with conflicting borrows: qubit borrowed in Z and X
pure fn test(q: qubit) -> proj {
    let p1 = q == |0>;
    let p2 = q == |+>;
    p1 && p2
}

// -----
// Test: conflicting borrows in if regions (Z and X basis)
// CHECK: Cannot combine projections with conflicting borrows: qubit borrowed in Z and X
unitary fn test(q: qubit) {
    let p = q == |0>;
    if p {
        let p2 = q == |+>;
        let p3 = p && p2;
        ph(0)
    }
}

// -----
// Test: duplicate qubit argument in function call
// CHECK: is passed into function twice
pure fn takes_two_qubits(q1: qubit, q2: qubit) {
}

pure fn test_duplicate(q: qubit) {
    takes_two_qubits(q, q)
}
