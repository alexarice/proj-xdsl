// RUN: xdsl-opt %s --parsing-diagnostics --split-input-file 2>&1 | filecheck %s

// -----
// Test: locally allocated qubit borrowed at return
// CHECK: Locally allocated qubit is still borrowed at return
mixed fn test() -> proj {
    let q = alloc |0>;
    let p = q == |0>;
    p
}

// -----
// Test: conflicting borrows in same block (Z and X basis)
// CHECK: Cannot combine projections with conflicting borrows: qubit borrowed in Z and X
pure fn test(q: qubit) -> proj {
    let p1 = q == |0>;
    let p2 = q == |+>;
    p1 && p2
}

// -----
// Test: conflicting borrows in qif regions (Z and X basis)
// CHECK: Cannot combine projections with conflicting borrows: qubit borrowed in Z and X
unitary fn test(q: qubit) {
    let p = q == |0>;
    qif p {
        let p2 = q == |+>;
        let p3 = p && p2;
        ph(0)
    }
}

// -----
// Test: duplicate qubit argument in function call
// CHECK: is passed into function twice
pure fn takes_two_qubits(q1: qubit, q2: qubit) {
}

pure fn test_duplicate(q: qubit) {
    takes_two_qubits(q, q)
}

// -----
// Test: nested qif with clashing projection conditions
// CHECK: Qif condition borrows qubit already borrowed by outer qif
unitary fn test_nested_if_clash(q: qubit) {
    qif q == |0> {
        qif q == |+> {
        }
    }
}

// -----
// Test: triple nested qif with clashing projection conditions
// CHECK: Qif condition borrows qubit already borrowed by outer qif
unitary fn test_triple_nested_if_clash(q1: qubit, q2: qubit) {
    qif q1 == |0> {
        qif q2 == |0> {
            qif q1 == |+> {
            }
        }
    }
}

// -----
// Test: function call in qif using condition's borrowed qubit (projection argument)
// CHECK: Function call argument has conflicting borrow with outer qif
pure fn takes_proj(p: proj) {
}

unitary fn test_if_call_clash(q: qubit) {
    qif q == |0> {
        takes_proj(q == |+>)
    }
}

// -----
// Test: function call in qif using condition's borrowed qubit (direct qubit argument)
// CHECK: Qubit argument conflicts with outer qif condition borrow
pure fn takes_qubit(q: qubit) {
}

unitary fn test_if_call_qubit_clash(q: qubit) {
    qif q == |0> {
        takes_qubit(q)
    }
}
