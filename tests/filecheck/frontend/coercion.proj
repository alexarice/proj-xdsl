// RUN: xdsl-opt %s | filecheck %s

// -----
// Test: bool → proj coercion at function call
// CHECK-LABEL: proj.pure @bool_to_proj
pure fn expects_proj(p: proj) -> proj { p }
pure fn bool_to_proj() -> proj {
    // CHECK: %[[C:.*]] = arith.constant true
    // CHECK: %[[COERCED:.*]] = proj.from_bool %[[C]]
    // CHECK: proj.call @expects_proj(%[[COERCED]])
    expects_proj(true)
}

// -----
// Test: qubit → qubit<X> coercion at function call
// CHECK-LABEL: proj.unitary @qubit_to_borrowed
unitary fn expects_borrowed(q: qubit<X>) {
    if q == |+> {
        ph(0)
    }
}
unitary fn qubit_to_borrowed(q: qubit) {
    // CHECK: %[[COERCED:.*]] = proj.borrow_basis %q, #proj.basis<x>
    // CHECK: proj.call @expects_borrowed(%[[COERCED]])
    expects_borrowed(q)
}

// -----
// Test: qubit → qubit<Y> coercion at function call
// CHECK-LABEL: proj.unitary @qubit_to_borrowed_y
unitary fn expects_borrowed_y(q: qubit<Y>) {
    if q == |L> {
        ph(0)
    }
}
unitary fn qubit_to_borrowed_y(q: qubit) {
    // CHECK: %[[COERCED:.*]] = proj.borrow_basis %q, #proj.basis<y>
    // CHECK: proj.call @expects_borrowed_y(%[[COERCED]])
    expects_borrowed_y(q)
}

// -----
// Test: qubit → qubit<Z> coercion at function call
// CHECK-LABEL: proj.unitary @qubit_to_borrowed_z
unitary fn expects_borrowed_z(q: qubit<Z>) {
    if q == |0> {
        ph(0)
    }
}
unitary fn qubit_to_borrowed_z(q: qubit) {
    // CHECK: %[[COERCED:.*]] = proj.borrow_basis %q, #proj.basis<z>
    // CHECK: proj.call @expects_borrowed_z(%[[COERCED]])
    expects_borrowed_z(q)
}

// -----
// Test: Multiple coercions in single call
// CHECK-LABEL: proj.pure @multiple_coercions
pure fn expects_two(p1: proj, p2: proj) -> proj { p1 && p2 }
pure fn multiple_coercions(q: qubit) -> proj {
    // CHECK-DAG: %[[EQ:.*]] = proj.eq %q : !proj.qubit, #proj.state<zero>
    // CHECK-DAG: %[[C1:.*]] = arith.constant true
    // CHECK-DAG: %[[COERCED1:.*]] = proj.from_bool %[[C1]]
    // CHECK: proj.call @expects_two(%[[COERCED1]], %[[EQ]])
    expects_two(true, q == |0>)
}

// -----
// Test: Coercion in return value (bool → proj)
// CHECK-LABEL: proj.pure @returns_bool_to_proj
pure fn returns_bool_to_proj() -> proj {
    // CHECK: %[[C:.*]] = arith.constant true
    // CHECK: %[[COERCED:.*]] = proj.from_bool %[[C]]
    // CHECK: proj.return %[[COERCED]] : !proj.projection
    true
}

// -----
// Test: Coercion in let binding (bool → proj)
// CHECK-LABEL: proj.pure @let_coercion_bool_to_proj
pure fn let_coercion_bool_to_proj() -> proj {
    // CHECK: %[[C:.*]] = arith.constant true
    // CHECK: %[[COERCED:.*]] = proj.from_bool %[[C]]
    // CHECK: proj.return %[[COERCED]]
    let p: proj = true;
    p
}

// -----
// Test: Coercion in measure operand (bool → proj)
// CHECK-LABEL: proj.mixed @measure_coercion_bool_to_proj
mixed fn measure_coercion_bool_to_proj() -> bool {
    // CHECK: %[[C:.*]] = arith.constant true
    // CHECK: %[[COERCED:.*]] = proj.from_bool %[[C]]
    // CHECK: %[[M:.*]] = proj.measure %[[COERCED]]
    measure(true)
}

// -----
// Test: Coercion in binary op left operand (bool → proj)
// CHECK-LABEL: proj.pure @binary_op_left_coercion
pure fn binary_op_left_coercion(q: qubit) -> proj {
    // CHECK-DAG: %[[C:.*]] = arith.constant true
    // CHECK-DAG: %[[EQ:.*]] = proj.eq %q
    // CHECK-DAG: %[[COERCED:.*]] = proj.from_bool %[[C]]
    // CHECK: %[[RESULT:.*]] = proj.and %[[COERCED]], %[[EQ]]
    true && (q == |0>)
}

// -----
// Test: Coercion in binary op right operand (bool → proj)
// CHECK-LABEL: proj.pure @binary_op_right_coercion
pure fn binary_op_right_coercion(q: qubit) -> proj {
    // CHECK-DAG: %[[EQ:.*]] = proj.eq %q
    // CHECK-DAG: %[[C:.*]] = arith.constant true
    // CHECK-DAG: %[[COERCED:.*]] = proj.from_bool %[[C]]
    // CHECK: %[[RESULT:.*]] = proj.and %[[EQ]], %[[COERCED]]
    (q == |0>) && true
}

// -----
// Test: No coercion needed (proj → proj)
// CHECK-LABEL: proj.pure @no_coercion_proj
pure fn no_coercion_proj(q: qubit) -> proj {
    // CHECK: %[[EQ:.*]] = proj.eq %q
    // CHECK: proj.call @expects_proj(%[[EQ]])
    expects_proj(q == |0>)
}

// -----
// Test: No coercion needed (qubit<X> → qubit<X>)
// CHECK-LABEL: proj.unitary @no_coercion_borrowed
unitary fn no_coercion_borrowed(q: qubit<X>) {
    // CHECK: proj.call @expects_borrowed(%q)
    expects_borrowed(q)
}
